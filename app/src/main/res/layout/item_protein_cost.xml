<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="12dp">

        <!-- Header -->
        <TextView
            android:id="@+id/MealRV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="4"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingRight="8dp"/>

        <!-- Column 1 Data -->

        <TextView
            android:id="@+id/ServingsRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="0"
            android:text="Servings: "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <TextView
            android:id="@+id/PriceRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:text="Total $: "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <!-- Column 2 Costs -->

        <TextView
            android:id="@+id/GramsRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:text="Protein (g): "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <TextView
            android:id="@+id/PercentRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="2"
            android:text="Cals/Serving: "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <TextView
            android:id="@+id/CostPer50RV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="1"
            android:text="Cost/50g: "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <TextView
            android:id="@+id/CostPer1RV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="1"
            android:text="Cost/g: "
            android:textSize="14sp"
            android:paddingRight="8dp"/>

        <TextView
            android:id="@+id/ServingCostRV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="3"
            android:layout_column="0"
            android:text="Cost/Serving: "
            android:textSize="14sp"
            android:paddingRight="8dp" />

    </GridLayout>
</com.google.android.material.card.MaterialCardView>
